# Copy to .env and fill in real values. Never commit .env.
# Get a Groq key at https://console.groq.com (keep it private; rotate it if it ever leaks).
GROQ_API_KEY=your_groq_api_key_here

# Used to sign login tokens. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=replace_with_a_long_random_string_min_32_chars

APP_ENV=development
LOG_LEVEL=INFO

# Optional: run a named experiment stage from eval/stages.yaml (empty = base config)
RAG_STAGE=
